ENV=development
DEBUG=true

# Prod: postgresql+psycopg2://user:pass@host:5432/uzhavan
DATABASE_URL=sqlite:///./uzhavan_dev.db

JWT_SECRET_KEY=change-me-to-a-random-64-char-string
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Bhashini — register at https://bhashini.gov.in
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Razorpay — https://dashboard.razorpay.com/app/keys (use test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# DigiLocker — https://partners.digilocker.gov.in
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://your-domain.example/kyc/callback

# Optional: only needed if you switch routing.py to Google Maps
GOOGLE_MAPS_API_KEY=

# Optional: data.gov.in OGD API key for stable Agmarknet JSON feed
OGD_INDIA_API_KEY=
